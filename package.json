{
  "name": "fifatables-stream",
  "version": "0.0.4",
  "packageManager": "bun@1.3.14",
  "description": "Streams for Fifa Soccer Game tables",
  "scripts": {
    "start": "rimraf dist && tsc-watch --build tsconfig.es5.json --onSuccess 'bun run postbuild'",
    "demo": "ts-node demo",
    "build": "rimraf dist && tsc --build tsconfig.es6.json && tsc --build tsconfig.es5.json",
    "postbuild": "bun run prepare-dist",
    "lint": "eslint .",
    "test": "vitest run",
    "prepare-dist": "ts-node --project scripts/tsconfig.ts-node.json scripts/prepare-dist",
    "gpr:setup": "ts-node --project scripts/tsconfig.ts-node.json scripts/gpr-setup",
    "prepare": "husky",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "postversion": "git push && git push --follow-tags",
    "publish:beta": "bun install && bun run build && npm publish --folder dist --tag beta",
    "release:beta": "npm version prerelease -m \"chore(update): prelease %s β\"",
    "release:patch": "git checkout master && npm version patch -m \"chore(update): patch release %s 🐛 \"",
    "release:minor": "git checkout master && npm version minor -m \"chore(update): release %s 🚀\"",
    "release:major": "git checkout master && npm version major -m \"chore(update): major release %s 💥 \""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Celtian/fifatables-stream.git"
  },
  "author": {
    "name": "Dominik Hladík",
    "email": "dominik.hladik@seznam.cz"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Celtian/fifatables-stream/issues"
  },
  "homepage": "https://github.com/Celtian/fifatables-stream#readme",
  "engines": {
    "node": ">=24",
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "byline": "^5.0.0",
    "fifatables": "^0.3.0",
    "iconv-lite": "^0.7.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/byline": "^4.2.36",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "auto-changelog": "^2.6.0",
    "eslint": "^10.8.0",
    "fs-extra": "^11.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2",
    "quick-commitlint": "^0.1.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsc-watch": "^7.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "data",
    "download",
    "football",
    "scraper",
    "soccer",
    "fifatables-stream"
  ],
  "auto-changelog": {
    "remote": "none",
    "commitUrl": "https://github.com/Celtian/fifatables-stream/commit/{id}",
    "issueUrl": "https://github.com/Celtian/fifatables-stream/issues/{id}",
    "mergeUrl": "https://github.com/Celtian/fifatables-stream/pull/{id}",
    "compareUrl": "https://github.com/Celtian/fifatables-stream/compare/{from}...{to}"
  }
}
